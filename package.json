{
  "name": "besiege-lite-web-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:boundary": "node scripts/verify-building-boundary.mjs",
    "test:event-boundary": "node scripts/verify-event-log-boundary.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:boundary && npm run test:event-boundary && npm run build",
    "part:validate": "node scripts/validate-part.mjs",
    "part:preview": "node scripts/part-preview.mjs",
    "part:qa": "node scripts/part-qa.mjs",
    "skill:install:img2threejs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-img2threejs.ps1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "better-auth": "^1.7.5",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
