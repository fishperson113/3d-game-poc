{
  "name": "besiege-lite-web-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "part:validate": "node scripts/validate-part.mjs",
    "part:preview": "vite --mode part-preview",
    "part:qa": "node scripts/part-qa.mjs",
    "skill:install:img2threejs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-img2threejs.ps1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
